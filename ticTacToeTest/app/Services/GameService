<?php


namespace App\Services;


use App\Models\Game;
use Carbon\Carbon;
use Illuminate\Support\Arr;
use InvalidArgumentException;


class GameService
{
private const WIN_LINES = [
[0,1,2],[3,4,5],[6,7,8], // rows
[0,3,6],[1,4,7],[2,5,8], // cols
[0,4,8],[2,4,6], // diagonals
];


public function newGame(): Game
{
return Game::create([
'board' => '---------',
'current_player' => 'X',
'status' => 'IN_PROGRESS',
'winner' => null,
'started_at' => now(),
]);
}
/**
* Make a move at 0..8 index for the current player.
*/
public function makeMove(Game $game, int $index): Game
{
if ($game->isFinished()) {
throw new InvalidArgumentException('Game already finished');
}
if ($index < 0 || $index > 8) {
throw new InvalidArgumentException('Index out of range');
}


$board = $game->boardArray();
if ($board[$index] !== '-') {
throw new InvalidArgumentException('Cell already taken');
}


$player = $game->current_player; // 'X' or 'O'
$board[$index] = $player;
$game->board = implode('', $board);
// Win?
if ($this->isWin($board, $player)) {
$game->status = $player === 'X' ? 'X_WON' : 'O_WON';
$game->winner = $player;
$game->finished_at = Carbon::now();
} elseif (!in_array('-', $board, true)) {
// Draw?
$game->status = 'DRAW';
$game->finished_at = Carbon::now();
} else {
// Continue
$game->current_player = $player === 'X' ? 'O' : 'X';
}


$game->save();
return $game->refresh();
}
private function isWin(array $board, string $player): bool
{
foreach (self::WIN_LINES as $line) {
if ($board[$line[0]] === $player && $board[$line[1]] === $player && $board[$line[2]] === $player) {
return true;
}
}
return false;
}
}